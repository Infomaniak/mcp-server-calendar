# Infomaniak calendar MCP server
# Copy to .env and fill in real values. Never commit a real .env.
#
# For full HTTP transport documentation (endpoint, host/origin validation,
# docker compose example, fallback to stdio), see docs/http.md.

# Required: Infomaniak API token with calendar scope.
CALENDAR_TOKEN=

# HTTP bind address. Default 127.0.0.1 (loopback). The published image sets
# 0.0.0.0 inside the container so the port is reachable from the host.
MCP_HTTP_HOST=127.0.0.1

# HTTP listen port. Must be an integer in the range 1..65535. Default 4500.
# The published image EXPOSEs 4500 and the ENTRYPOINT listens on MCP_HTTP_PORT.
MCP_HTTP_PORT=4500

# Comma-separated list of `Host` header values that the server will accept.
# If unset, loopback hostnames are allowed (127.0.0.1, localhost, [::1]).
# Example for production behind a reverse proxy:
#   MCP_HTTP_ALLOWED_HOSTS=calendar.example.com,127.0.0.1,localhost
MCP_HTTP_ALLOWED_HOSTS=

# Comma-separated list of `Origin` header values that the server will accept.
# A trailing `*` is a wildcard that matches any suffix (e.g.
# `http://127.0.0.1:*` matches any port on that hostname). If unset, the
# loopback origins with `:*` are allowed.
# Example for production:
#   MCP_HTTP_ALLOWED_ORIGINS=https://calendar.example.com
MCP_HTTP_ALLOWED_ORIGINS=
