# Infomaniak calendar MCP server
# Copy to .env and fill in real values. Never commit a real .env.
#
# For full HTTP transport documentation (endpoint, host/origin validation,
# docker compose example, fallback to stdio), see docs/http.md.
#
# PRECEDENCE, and why it bites:
#     your .env   >   Dockerfile ENV   >   code default
# The published image deliberately sets MCP_HTTP_HOST=0.0.0.0 so the port is
# reachable from outside the container. Uncommenting the line below REVERSES
# that: the container then listens on loopback only, and the published port
# accepts each connection and immediately closes it ("Empty reply from server"),
# because docker-proxy cannot reach a loopback-only bind from outside.

# Required: Infomaniak API token with calendar scope.
CALENDAR_TOKEN=

# HTTP bind address. Code default (when unset): 127.0.0.1, loopback.
# The image overrides it to 0.0.0.0, which is what you want in a container.
# Only uncomment this to pin a specific interface address.
# MCP_HTTP_HOST=0.0.0.0

# HTTP listen port. Must be an integer in the range 1..65535. Default 4500.
# The published image EXPOSEs 4500 and the ENTRYPOINT listens on MCP_HTTP_PORT.
MCP_HTTP_PORT=4500

# Optional: comma-separated list of `Host` header values the server will accept.
# These must be BARE HOSTNAMES - `calendar.example.com`, never a URL. A Host
# header never carries a scheme, so an entry like `https://calendar.example.com`
# can never match and that hostname is rejected with 403. The server warns about
# this shape at startup.
#
# If the variable is UNSET, loopback hostnames are allowed (127.0.0.1,
# localhost, [::1]). Do NOT set it to an empty value: empty is not unset, and an
# empty list is a startup error.
# Example for production behind a reverse proxy:
# MCP_HTTP_ALLOWED_HOSTS=calendar.example.com,127.0.0.1,localhost

# Optional: comma-separated list of `Origin` header values the server will accept.
# A trailing `*` is a wildcard that matches any suffix (e.g.
# `http://127.0.0.1:*` matches any port on that hostname). If unset, the
# loopback origins with `:*` are allowed.
#
# The single value `*` matches EVERY origin, which disables the cross-origin and
# DNS-rebinding guard entirely (a hostile Origin, and even `Origin: null`, are
# accepted). The server warns about that at startup. Use concrete origins.
# Example for production:
# MCP_HTTP_ALLOWED_ORIGINS=https://calendar.example.com
