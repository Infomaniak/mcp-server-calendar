# Infomaniak calendar MCP server
# Copy to .env and fill in real values. Never commit a real .env.
#
# For full HTTP transport documentation (endpoint, host/origin validation,
# docker compose example, fallback to stdio), see docs/http.md.

# Required: Infomaniak API token with calendar scope.
CALENDAR_TOKEN=

# HTTP bind address. Unset: code default 127.0.0.1, image overrides to 0.0.0.0.
# Your .env beats the image, so pinning 127.0.0.1 in a container makes the
# published port accept-and-close (curl: (52) Empty reply from server).
# MCP_HTTP_HOST=0.0.0.0

# HTTP listen port. Must be an integer in the range 1..65535. Default 4500.
# The published image EXPOSEs 4500 and the ENTRYPOINT listens on MCP_HTTP_PORT.
MCP_HTTP_PORT=4500

# Optional: comma-separated `Host` header values to accept, as BARE HOSTNAMES
# (`calendar.example.com`, never a URL - a Host header carries no scheme, so an
# `https://...` entry never matches and that host is rejected 403). Unset allows
# loopback only; empty is a startup error, not "unset".
# MCP_HTTP_ALLOWED_HOSTS=calendar.example.com,127.0.0.1,localhost

# Optional: comma-separated `Origin` header values to accept. A trailing `*` is
# a suffix wildcard, so `*` alone matches every origin and disables the
# cross-origin/DNS-rebinding guard. Unset allows loopback origins with `:*`.
# MCP_HTTP_ALLOWED_ORIGINS=https://calendar.example.com
